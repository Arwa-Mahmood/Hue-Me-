# Railway Postgres connection string, used by auth, profile and admin (ask Ayesha)
DATABASE_URL=
JWT_SECRET=
# Email codes. Brevo API key (xkeysib-..., Brevo > SMTP & API > API Keys): if set, emails go over
# HTTPS, which works on Railway. Without it the SMTP settings below are used (blocked on Railway Free/Hobby).
BREVO_API_KEY=
# SMTP_FROM is the sender for both ways and must be a verified sender in Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_LOGIN=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Deployed frontend address(es), comma-separated, e.g. https://hue-me.vercel.app
FRONTEND_URL=
